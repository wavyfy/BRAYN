# See src/config/env.schema.ts for the canonical, validated list.
# Never commit actual values — this file documents shape only.

NODE_ENV=development
PORT=3001

# Primary database — Neon PostgreSQL
DATABASE_URL=

# Authentication — Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Object storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Redis — Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Observability — Sentry
SENTRY_DSN=

# Provider credential encryption — 64-char hex (32 bytes), e.g. `openssl rand -hex 32`
BRAYN_CREDENTIAL_ENCRYPTION_KEY=

# Frontend origin allowed to call this API (CORS)
FRONTEND_URL=http://localhost:3000

# This API's own public origin — must match the Allowed redirection URL
# registered for the Shopify app in the Dev Dashboard (redirect_uri =
# {BACKEND_URL}/api/v1/integrations/shopify/oauth/callback)
BACKEND_URL=http://localhost:3001

# Shopify OAuth app credentials — Dev Dashboard > your app > Client credentials
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
